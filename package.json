{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node populate_json.cjs && node prepare-pwa-assets.js && tsx server.ts",
    "build": "node populate_json.cjs && node prepare-pwa-assets.js && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@supabase/supabase-js": "^2.110.5",
    "canvas-confetti": "^1.9.3",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.395.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.2.2",
    "vite": "^5.3.1"
  }
}
