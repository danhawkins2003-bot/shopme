# Configuration Générale de l'Application Asime Togo
# Numéro WhatsApp marchand pour la validation de commande (sans le sign + ex: 22890000000)
VITE_WHATSAPP_MERCHANT_NUMBER=22890000000

# Téléphones visibles pour le service client et l'administration
VITE_PHONE_DISPLAY_PRIMARY=+228 90 00 00 00
VITE_PHONE_DISPLAY_SECONDARY=+228 97 00 00 00

# E-mail de support officiel de la boutique
VITE_SUPPORT_EMAIL=support@asime228.com

# Configuration Google AdSense
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_LEADERBOARD=1234567890
VITE_ADSENSE_SLOT_SQUARE=1234567890
VITE_ADSENSE_SLOT_HORIZONTAL=1234567890

# Liens d'affiliation globaux par défaut (Amazon et AliExpress)
VITE_DEFAULT_AFFILIATE_URL=https://s.click.aliexpress.com/e/_DdYxyz
VITE_DEFAULT_AMAZON_URL=https://www.amazon.com/Best-Sellers-Electronics/zgbs/electronics

# configuration PayDunya (Production / Réel)
# Obtenez vos clés sur votre tableau de bord PayDunya (https://paydunya.com)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# Définir à "live" pour la production, ou "test" pour le mode sandbox
PAYDUNYA_MODE=test

# Configuration de la base de données Supabase (Optionnelle - persistance Cloud résiliente)
# Obtenez vos identifiants sur votre projet Supabase (https://supabase.com -> Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé Service Role (recommandée pour contourner les règles RLS côté serveur)
SUPABASE_SERVICE_ROLE_KEY=

